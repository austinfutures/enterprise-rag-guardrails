# Offline mode (default): no API key needed, deterministic, used by tests & CI.
RAG_LLM_PROVIDER=extractive
RAG_EMBEDDING_PROVIDER=hash

# Production mode: uncomment to use OpenAI for generation + embeddings.
# NOTE: switching embedding provider requires a fresh index (make clean && make ingest).
# RAG_LLM_PROVIDER=openai
# RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_HALLUCINATION_MODE=llm          # LLM-as-judge claim verification

# Optional API key protection for /ingest and /query (send as X-API-Key header)
# RAG_API_KEY=change-me

# Phoenix tracing target (used by `make evaluate-ragas`)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
